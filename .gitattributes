# Rust sources stay LF everywhere. Git's autocrlf would otherwise rewrite every file
# on checkout, which makes diffs noisy and breaks the byte offsets in error output.
* text=auto eol=lf

*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf

# Windows-only binary artifacts.
*.exe binary
*.dll binary
*.pdb binary

# The icon is a real binary file, and it is the one asset that is checked in rather than
# compiled in. `text=auto` above would be guessing at its first NUL byte; this says so.
*.ico binary

# Keep generated lockfiles out of language statistics.
Cargo.lock linguist-generated=true
